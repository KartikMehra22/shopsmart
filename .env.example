# Copy to `.env` and fill in real values. Never commit `.env`.

# Prisma / database connection (SQLite example: file:./prisma/dev.db; use your host Postgres URL in production)
# DATABASE_URL=

# Node environment: development | production | test
# NODE_ENV=

# Port the Express API listens on (must match your deployment platform if it injects PORT)
# PORT=

# Vite: public API base URL the browser calls (e.g. http://localhost:5001 for local dev)
# VITE_API_URL=
